# Apache config for cPanel hosting (Vercel uses vercel.json instead).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Single-page app: serve real files and folders as-is (assets, ads.txt,
  # logo.png, .well-known for SSL renewal), send every other path to
  # index.html so React Router can resolve it. Without this, direct loads
  # of /contact-us, /ssuunnlliitt etc. would 404.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Built assets have content hashes in their names, so cache them hard.
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Never cache index.html, so visitors get new builds straight away.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
