# Apache config for cPanel hosting (Vercel uses vercel.json instead).

# Serve the app's index.html, even if an old index.php is still on the server.
DirectoryIndex index.html

# No directory listings.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block hidden files (.env, .git, etc.) but keep .well-known for SSL renewal.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Single-page app: serve real files and folders as-is (assets, ads.txt,
  # logo.png, .well-known), send every other path to index.html so React
  # Router can resolve it. Without this, direct loads of /contact-us,
  # /ssuunnlliitt etc. would 404.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers. Scripts are not restricted by CSP because Google AdSense
  # loads from many Google domains; the policy below covers framing, plugins,
  # base-tag and form hijacking instead.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Keep the admin area out of search engines. Matched on the original request
  # line, because the SPA rewrite to index.html renames per-request env vars.
  <If "%{THE_REQUEST} =~ m#^\S+\s+/ssuunnlliitt#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  # Built assets have content hashes in their names, so cache them hard.
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Never cache index.html, so visitors get new builds straight away.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
